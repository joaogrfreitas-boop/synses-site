# Formulário "Quero conhecer a Synses" (envio via Resend).
# Configure estas variáveis no painel da Vercel (Settings → Environment Variables).
# Nunca coloque a chave no código nem neste arquivo.

# Chave da API do Resend.
RESEND_API_KEY=

# Remetente: use um endereço do subdomínio verificado no Resend (ex.: forms.synses.app),
# nunca o domínio raiz synses.app, para não interferir no e-mail da GoDaddy.
CONTACT_FROM_EMAIL="Site Synses <contato@forms.synses.app>"

# Destino: seu e-mail corporativo já existente.
CONTACT_TO_EMAIL=
